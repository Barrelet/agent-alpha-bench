data/*
!data/.gitkeep
!data/summary/
!data/summary/*

# python
__pycache__/
*.egg-info/
.pytest_cache/
.env

# jupyter
.ipynb_checkpoints/

# os
.DS_Store

# secrets and local config
*.key
*.pem
.env.*
local_settings.py
